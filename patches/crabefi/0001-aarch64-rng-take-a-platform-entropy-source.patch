+/// A platform-provided entropy source, as a `fn(&mut [u8]) -> bool`; 0 when
+/// none was registered.
+static PLATFORM_SOURCE: AtomicUsize = AtomicUsize::new(0);
+
+/// Register the platform's own hardware RNG.
+///
+/// When set, it is used instead of RNDR and SMCCC TRNG, and no SMC is issued
+/// to probe for a TRNG: on platforms without EL3 firmware (or with `SMC`
+/// disabled by `SCR_EL3.SMD`) that probe is an undefined instruction.
+pub fn set_platform_source(source: fn(&mut [u8]) -> bool) {
+    PLATFORM_SOURCE.store(source as usize, Ordering::Release);
+}
+
+fn platform_source() -> Option<fn(&mut [u8]) -> bool> {
+    let raw = PLATFORM_SOURCE.load(Ordering::Acquire);
+    // SAFETY: only `set_platform_source` stores a nonzero value, and it stores
+    // a `fn(&mut [u8]) -> bool`.
+    (raw != 0).then(|| unsafe { core::mem::transmute::<usize, fn(&mut [u8]) -> bool>(raw) })
+}
