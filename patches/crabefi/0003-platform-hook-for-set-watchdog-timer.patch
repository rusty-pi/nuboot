@@ -188,10 +188,13 @@ extern "efiapi" fn set_watchdog_timer(
         timeout,
         watchdog_code
     );
-    // Accept the call but don't implement actual watchdog.
-    // The UEFI spec default is a 5-minute watchdog that bootloaders disable
-    // by calling SetWatchdogTimer(0, 0, 0, NULL). Returning SUCCESS lets
-    // Windows Boot Manager proceed without error.
+    // The platform has the watchdog, if there is one. The UEFI spec default
+    // is a 5-minute watchdog that bootloaders disable by calling
+    // SetWatchdogTimer(0, 0, 0, NULL). Returning SUCCESS lets Windows Boot
+    // Manager proceed without error.
+    if let Some(hooks) = crate::handoff::callbacks().hooks {
+        hooks.set_watchdog_timer(timeout);
+    }
     Status::SUCCESS
 }
 
