+/// A PCIe host bridge whose configuration space is not ECAM, and whose bus
+/// addresses are not CPU addresses: the platform reaches it and translates
+/// for it. Installed with [`crate::drivers::pci::set_platform_pci`]; it takes
+/// the place of ECAM on segment 0.
+pub trait PlatformPci: Sync {
+    /// The buses to enumerate.
+    fn bus_range(&self) -> (u8, u8);
+
+    /// A dword of configuration space; all-ones where no function answers.
+    fn read32(&self, bus: u8, device: u8, function: u8, offset: u16) -> u32;
+
+    fn write32(&self, bus: u8, device: u8, function: u8, offset: u16, value: u32);
+
+    /// The CPU address of a memory BAR's bus address.
+    fn mmio_to_cpu(&self, bus_address: u64) -> u64 {
+        bus_address
+    }
+
+    /// How devices behind the bridge see memory.
+    fn dma_domain(&self) -> Option<crate::efi::dma::DmaDomain> {
+        None
+    }
+}
