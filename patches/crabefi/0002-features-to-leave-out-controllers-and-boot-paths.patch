diff --git a/crabefi-core/Cargo.toml b/crabefi-core/Cargo.toml
index 6b071ec..81150bd 100644
--- a/crabefi-core/Cargo.toml
+++ b/crabefi-core/Cargo.toml
@@ -9,7 +9,17 @@ repository.workspace = true
 readme = "../README.md"
 
 [features]
-default = []
+default = ["ahci", "nvme", "usb-legacy", "linux-direct", "el-torito"]
+# PCI storage controllers.
+ahci = []
+nvme = []
+# USB 2.0/1.1 host controllers (EHCI, OHCI and, on x86_64, UHCI).
+usb-legacy = []
+# Booting a kernel straight from a BLS entry or a grub.cfg menu entry without a
+# bootloader in between (never offered while Secure Boot is on).
+linux-direct = []
+# The EFI boot image of an El Torito CD/ISO without an ESP partition.
+el-torito = []
 # Capabilities are additive; external firmware opts into its exact hardware set.
 xhci = ["dep:xhci"]
 # TPM devices, TCG protocols, event tables and measured boot.
